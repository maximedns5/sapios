-- Helpers communs aux tests pgTAP, inclus par `\ir _helpers.psql` dans chaque fichier.
-- Tout vit dans pg_temp et dans la transaction du test (rollback à la fin).
-- Les données sont préparées en tant que postgres ; les assertions d'accès se font toujours
-- après pg_temp.login(...) (rôle authenticated + request.jwt.claims), pg_temp.login_anon()
-- ou pg_temp.login_service().

create extension if not exists pgtap with schema extensions;

-- Identifiants déterministes : aaaaaaaa-0000-4000-8000-0000000000NN.
create function pg_temp.uid(p_n int)
returns uuid
language sql
immutable
as $$
  select ('aaaaaaaa-0000-4000-8000-' || lpad(p_n::text, 12, '0'))::uuid;
$$;

create function pg_temp.new_user(p_n int)
returns uuid
language plpgsql
as $$
declare
  v uuid := pg_temp.uid(p_n);
begin
  insert into auth.users (instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
                          raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values ('00000000-0000-0000-0000-000000000000', v, 'authenticated', 'authenticated',
          'pgtap-' || p_n || '@sapios.test', '', now(),
          '{"provider": "email", "providers": ["email"]}', '{}', now(), now());
  return v;
end;
$$;

-- Compte candidat (Sapios Emploi) avec identité chiffrée et, si `p_tier` est fourni, un diplôme vérifié
-- dans user_access (7 = Bac+5 pour standard, 8 pour unlimited, 6 pour waitlist, 5 sinon).
create function pg_temp.new_member(p_n int, p_tier public.access_tier default null)
returns uuid
language plpgsql
as $$
declare
  v uuid := pg_temp.new_user(p_n);
begin
  insert into public.emploi_accounts (user_id, kind) values (v, 'candidate');
  insert into public.candidate_identities (user_id, first_name, last_name_enc)
  values (v, 'Membre', private.encrypt_text('Test ' || p_n));
  if p_tier is not null then
    insert into public.user_access (user_id, level, tier, copy_key)
    values (v, case p_tier when 'unlimited' then 8 when 'standard' then 7 when 'waitlist' then 6 else 5 end,
            p_tier, 'verdict.' || p_tier::text);
  end if;
  return v;
end;
$$;

-- `p_aal` : niveau d'authentification du JWT. Par défaut aal2 (double authentification passée),
-- exigé par `public.is_admin()` ; passer 'aal1' pour tester une session sans second facteur.
create function pg_temp.login(p_uid uuid, p_aal text default 'aal2')
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_uid, 'role', 'authenticated', 'aud', 'authenticated', 'aal', p_aal)::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create function pg_temp.login_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role": "anon"}', true);
  perform set_config('role', 'anon', true);
end;
$$;

create function pg_temp.login_service()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role": "service_role"}', true);
  perform set_config('role', 'service_role', true);
end;
$$;

-- Retour à postgres (préparation de données uniquement).
create function pg_temp.logout()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '', true);
  perform set_config('role', 'postgres', true);
end;
$$;
