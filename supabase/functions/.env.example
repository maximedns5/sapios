# Secrets des Edge Functions. En local : copier en supabase/functions/.env (non versionné).
# En production : `supabase secrets set NOM=valeur`.

# Secret partagé avec la base (Vault `internal_secret`) : en-tête x-sapios-secret des fonctions
# process-diploma, notify et purge-diplomas.
SAPIOS_INTERNAL_SECRET=sapios-local-internal-secret

# Clé de l'API Claude (extraction des diplômes). Vide : les soumissions passent en revue humaine
# avec le signal `extraction_unavailable`.
ANTHROPIC_API_KEY=

# Jeton d'accès Expo (facultatif, si la sécurité renforcée des push est activée).
EXPO_ACCESS_TOKEN=

# Adresse publique de l'API, pour les URL signées du back-office. En local, SUPABASE_URL vu depuis
# les fonctions est l'adresse interne de la passerelle ; en production, laisser vide.
SAPIOS_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
