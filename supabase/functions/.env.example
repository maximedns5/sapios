# Secrets des Edge Functions. En local : copier en supabase/functions/.env (non versionné).
# En production : `supabase secrets set NOM=valeur`.

# Secret partagé avec la base (Vault `internal_secret`) : en-tête x-sapios-secret des fonctions
# process-diploma, notify et purge-diplomas.
SAPIOS_INTERNAL_SECRET=sapios-local-internal-secret

# Clé de l'API Claude (extraction des diplômes). Vide : mode manuel, les soumissions passent en revue
# humaine avec le marqueur `manual_review`.
ANTHROPIC_API_KEY=

# Jeton d'accès Expo (facultatif, si la sécurité renforcée des push est activée).
EXPO_ACCESS_TOKEN=

# Emails transactionnels de notify (verdict, nouveau match) par l'API Resend : docs/EMAILS.md.
# Clé ou expéditeur vide : canal désactivé, notify n'envoie que les push (journal, pas d'erreur).
# En local, laisser vide : Resend n'a pas d'équivalent Mailpit pour son API HTTP.
RESEND_API_KEY=
# Expéditeur sur le domaine vérifié chez Resend, ex. Sapios <bonjour@mail.exemple.fr>
EMAIL_FROM=
# Adresse de l'app membre, pour les liens des emails (sans / final). Vide : emails sans lien.
SAPIOS_APP_URL=http://localhost:8081

# Adresse publique de l'API, pour les URL signées du back-office. En local, SUPABASE_URL vu depuis
# les fonctions est l'adresse interne de la passerelle ; en production, laisser vide.
SAPIOS_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
