# URL de l'API Supabase et clé publique « anon » (npx supabase status). Jamais la clé service_role.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Connexion par mot de passe (comptes de test du seed). Toujours active en développement (__DEV__).
EXPO_PUBLIC_ENABLE_PASSWORD_LOGIN=false

# Identifiant de projet EAS, requis pour obtenir un jeton Expo Push sur appareil.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Adresse de contact de l'éditeur (exigence des stores).
EXPO_PUBLIC_CONTACT_EMAIL=contact@sapios.app

# Site public (landing) : liens « Confidentialité » et « Contact » de l'app. Par défaut https://sapios.app.
EXPO_PUBLIC_SITE_URL=
