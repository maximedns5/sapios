# URL de l'API Supabase et clé anon (publishable). Jamais de clé service_role ici.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse de l'application candidat (export web d'Expo), cible du bouton « Je cherche un emploi »
# de la landing. Sans elle, le bouton mène à la section « Comment ça marche ».
NEXT_PUBLIC_APP_URL=

# Adresses de contact affichées sur /contact et dans les pages légales (facultatif).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# « true » une fois les CGU candidats, les conditions recruteurs, la politique de confidentialité et
# les mentions légales validées par le juriste : retire le bandeau « version provisoire », autorise
# l'indexation, ajoute les pages au plan du site et les liens au pied de page.
NEXT_PUBLIC_LEGAL_PAGES_READY=
