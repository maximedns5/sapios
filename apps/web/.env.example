# URL de l'API Supabase et clé anon (publishable). Jamais de clé service_role ici.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresses de contact affichées sur /contact et /confidentialite (facultatif).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# « true » une fois les CGU et les mentions légales validées par le juriste : retire le bandeau
# « version provisoire », autorise l'indexation et ajoute les liens au pied de page.
NEXT_PUBLIC_LEGAL_PAGES_READY=

# « true » en local ou en staging seulement : connexion par mot de passe pour les comptes recruteurs de test.
# Jamais en production.
NEXT_PUBLIC_RECRUITER_PASSWORD_LOGIN=
